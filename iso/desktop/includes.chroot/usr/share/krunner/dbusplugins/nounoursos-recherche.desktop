[Desktop Entry]
Name=NounoursOS
Comment=Réglages de Paramètres et actions NounoursOS
Icon=nounoursos
X-KDE-ServiceTypes=Plasma/Runner
Type=Service
X-KDE-PluginInfo-Author=NounoursCorp
X-KDE-PluginInfo-Name=nounoursos-recherche
X-KDE-PluginInfo-Version=1.3
X-KDE-PluginInfo-License=GPL
X-KDE-PluginInfo-EnabledByDefault=true
X-Plasma-API=DBus
X-Plasma-DBusRunner-Service=fr.nounourscorp.Recherche
X-Plasma-DBusRunner-Path=/recherche
X-Plasma-Request-Actions-Once=true
