#!/bin/bash
# NounoursOS — actions administrateur appelées via pkexec par les applis NounoursOS.
# Liste fermée d'actions : rien d'autre ne peut être exécuté par ce biais.
set -e
umask 022
case "$1" in
  auto-securite)
    case "$2" in on) v=1 ;; off) v=0 ;; *) echo "usage: auto-securite on|off" >&2; exit 2 ;; esac
    cat > /etc/apt/apt.conf.d/20auto-upgrades <<CONF
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "$v";
CONF
    ;;
  groupe-docker)
    # Ajoute l'utilisateur qui a demandé (via pkexec) au groupe docker, pour WinBoat
    u=$(getent passwd "${PKEXEC_UID:-}" | cut -d: -f1)
    [ -n "$u" ] || { echo "Utilisateur inconnu" >&2; exit 2; }
    usermod -aG docker "$u"
    systemctl enable --now docker.service >/dev/null 2>&1 || true
    ;;
  empreinte-pam)
    # Empreinte acceptée pour sudo, polkit et la connexion (pam-auth-update)
    case "$2" in
      on)  pam-auth-update --package --enable fprintd ;;
      off) pam-auth-update --package --disable fprintd ;;
      *) echo "usage: empreinte-pam on|off" >&2; exit 2 ;;
    esac
    ;;
  mode-jeu)
    # Steam, GameMode, Vulkan 32 bits et, si besoin, le pilote NVIDIA (dépôts contrib/non-free)
    export DEBIAN_FRONTEND=noninteractive
    mkdir -p /var/log/nounoursos
    OPTS="-y -q -o DPkg::Lock::Timeout=300 -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold -o APT::Status-Fd=1"
    {
      echo "=== $(date '+%F %T') : mode-jeu"
      dpkg --add-architecture i386
      apt-get -q -o DPkg::Lock::Timeout=300 update
      PAQUETS="steam-installer gamemode mesa-vulkan-drivers mesa-vulkan-drivers:i386 libgl1-mesa-dri:i386 libglx-mesa0:i386"
      if lspci 2>/dev/null | grep -qiE 'VGA.*NVIDIA|3D.*NVIDIA'; then
        PAQUETS="$PAQUETS nvidia-driver firmware-misc-nonfree nvidia-driver-libs:i386"
      fi
      apt-get $OPTS install $PAQUETS
    } 2>&1 | tee -a /var/log/nounoursos/mode-jeu.log
    exit "${PIPESTATUS[0]:-0}"
    ;;
  nettoyage-systeme)
    # Paquets téléchargés, paquets devenus inutiles, anciens journaux, applis Flatpak orphelines
    export DEBIAN_FRONTEND=noninteractive
    apt-get -q clean
    apt-get -y -q -o DPkg::Lock::Timeout=120 autoremove --purge
    journalctl --vacuum-size=200M >/dev/null 2>&1 || true
    command -v flatpak >/dev/null && flatpak uninstall --system --unused -y --noninteractive >/dev/null 2>&1 || true
    ;;
  maj-maintenant|maj-preparer)
    # Mise à jour avec APT (plus fiable que PackageKit pour les paquets NounoursOS) :
    # pas de question de configuration, attente si un autre outil tient le verrou,
    # progression lisible (APT::Status-Fd) et journal complet.
    export DEBIAN_FRONTEND=noninteractive
    mkdir -p /var/log/nounoursos /var/lib/nounoursos
    LOG=/var/log/nounoursos/maj.log
    OPTS="-y -q -o DPkg::Lock::Timeout=300 -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold -o APT::Status-Fd=1"
    run_maj() {
      echo "=== $(date '+%F %T') : $1"
      apt-get -q -o DPkg::Lock::Timeout=300 update || return $?
      if [ "$1" = maj-maintenant ]; then
        apt-get $OPTS full-upgrade || return $?
        apt-get -y -q -o DPkg::Lock::Timeout=300 autoremove || true
      else
        apt-get $OPTS --download-only full-upgrade || return $?
        touch /var/lib/nounoursos/maj-au-demarrage
      fi
    }
    run_maj "$1" 2>&1 | tee -a "$LOG"
    exit "${PIPESTATUS[0]:-0}"
    ;;
  streamer-obs)
    # Kit streamer : OBS Studio depuis Debian
    export DEBIAN_FRONTEND=noninteractive
    apt-get install -y obs-studio
    ;;
  minecraft-java)
    # Java pour le serveur Minecraft (versions proposées par Debian uniquement)
    case "$2" in 21|25) ;; *) echo "usage: minecraft-java 21|25" >&2; exit 2 ;; esac
    export DEBIAN_FRONTEND=noninteractive
    apt-get install -y "openjdk-$2-jre-headless"
    ;;
  minecraft-linger)
    # Le serveur Minecraft de l'utilisateur peut tourner sans session ouverte
    u=$(getent passwd "${PKEXEC_UID:-}" | cut -d: -f1)
    [ -n "$u" ] || { echo "Utilisateur inconnu" >&2; exit 2; }
    case "$2" in on) loginctl enable-linger "$u" ;; off) loginctl disable-linger "$u" ;; *) exit 2 ;; esac
    ;;
  instantane-preparer)
    # Retour en arrière : configure snapper (système en Btrfs uniquement)
    /usr/libexec/nounoursos/nounoursos-instantanes
    [ -f /etc/snapper/configs/root ] || { echo "Le système n'est pas en Btrfs." >&2; exit 3; }
    ;;
  instantane-creer)
    d=$(printf '%s' "${2:-Point de restauration}" | tr -cd '[:alnum:] àâäçéèêëîïôöùûüÿÀÂÇÉÈÊËÎÔÙÛ._:()-' | cut -c1-80)
    snapper -c root create -c number -d "$d" --userdata "important=yes" -p
    ;;
  instantane-restaurer)
    # Remet les fichiers du système (hors /home, journaux et cache) dans l'état de l'instantané N
    case "$2" in ''|*[!0-9]*) echo "usage: instantane-restaurer <numéro>" >&2; exit 2 ;; esac
    [ "$2" -gt 0 ] || exit 2
    snapper -c root create -c number -d "Avant le retour à l'instantané $2" -p >/dev/null
    snapper -c root undochange "$2..0"
    ;;
  instantane-supprimer)
    case "$2" in ''|*[!0-9]*) echo "usage: instantane-supprimer <numéro>" >&2; exit 2 ;; esac
    [ "$2" -gt 0 ] || exit 2
    snapper -c root delete "$2"
    ;;
  *) echo "Action inconnue : $1" >&2; exit 2 ;;
esac
