#!/bin/sh
# NounoursOS — personnalisation de l'édition bureau
set -e

echo "[NounoursOS] Écran de démarrage Plymouth"
# On part du thème "spinner" (animations), on remplace le logo et les couleurs
T=/usr/share/plymouth/themes
rm -rf "$T/nounoursos"
cp -a "$T/spinner" "$T/nounoursos"
rm -f "$T/nounoursos/spinner.plymouth"
cp /usr/share/nounoursos/plymouth/nounoursos.plymouth "$T/nounoursos/nounoursos.plymouth"
cp /usr/share/nounoursos/plymouth/watermark.png        "$T/nounoursos/watermark.png"
plymouth-set-default-theme nounoursos

echo "[NounoursOS] Installateur Calamares"
# Notre branding à la place de celui de Debian
sed -i 's/^branding:.*/branding: nounoursos/' /etc/calamares/settings.conf
# On masque le lanceur "Install Debian" (le nôtre s'appelle "Installer NounoursOS")
for f in /usr/share/applications/calamares-install-debian.desktop \
         /usr/share/applications/install-debian.desktop; do
  if [ -f "$f" ]; then sed -i '/^\[Desktop Entry\]/a NoDisplay=true' "$f"; fi
done
# Et l'icône "Install Debian" posée sur le bureau en live
if [ -f /etc/xdg/autostart/calamares-desktop-icon.desktop ]; then
  sed -i '/^\[Desktop Entry\]/a Hidden=true' /etc/xdg/autostart/calamares-desktop-icon.desktop
fi

echo "[NounoursOS] WinBoat : les comptes créés par l'installateur rejoignent le groupe docker"
U=/etc/calamares/modules/users.conf
if [ -f "$U" ] && ! grep -qE '^[[:space:]]*-[[:space:]]*(name:[[:space:]]*)?docker[[:space:]]*$' "$U"; then
  if grep -qE '^defaultGroups:[[:space:]]*$' "$U"; then
    sed -i '/^defaultGroups:[[:space:]]*$/a\    - docker' "$U"
  else
    printf '\ndefaultGroups:\n    - users\n    - lpadmin\n    - netdev\n    - plugdev\n    - bluetooth\n    - docker\n' >> "$U"
  fi
fi
grep -n -A12 '^defaultGroups' "$U" || true

echo "[NounoursOS] Thème GRUB : polices Inter (identité NounoursOS)"
T=/usr/share/grub/themes/nounoursos
F=/usr/share/fonts/opentype/inter
if command -v grub-mkfont >/dev/null && [ -f "$F/Inter-Regular.otf" ]; then
  # Noms distincts pour que GRUB ne confonde pas les graisses
  grub-mkfont -s 16 -n "Inter" -o "$T/inter_16.pf2" "$F/Inter-Regular.otf" 2>/dev/null || true
  grub-mkfont -s 16 -n "Inter Fort" -o "$T/inter_fort_16.pf2" "$F/Inter-SemiBold.otf" 2>/dev/null || true
  grub-mkfont -s 30 -n "Inter Fort" -o "$T/inter_fort_30.pf2" "$F/Inter-Bold.otf" 2>/dev/null || true
fi
ls "$T"/*.pf2 2>/dev/null || echo "(polices GRUB non générées : police par défaut utilisée)"

echo "[NounoursOS] Curseur NounoursOS par défaut (aussi hors KDE)"
update-alternatives --install /usr/share/icons/default/index.theme x-cursor-theme \
  /usr/share/icons/NounoursOS/cursor.theme 95 || true
update-alternatives --set x-cursor-theme /usr/share/icons/NounoursOS/cursor.theme || true

echo "[NounoursOS] Capsule temporelle : minuteur pour chaque compte"
systemctl --global enable nounoursos-capsule.timer || true

echo "[NounoursOS] Empreinte digitale : acceptée pour sudo, polkit et la connexion"
pam-auth-update --package --enable fprintd || true

echo "[NounoursOS] Logithèque : Flathub disponible dans Discover"
flatpak remote-add --system --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo || true

echo "[NounoursOS] Notifications de mise à jour : celles de NounoursOS remplacent celles de Discover"
for f in /etc/xdg/autostart/org.kde.discover.notifier.desktop; do
  if [ -f "$f" ]; then sed -i '/^\[Desktop Entry\]/a Hidden=true' "$f"; fi
done

echo "[NounoursOS] Droits des outils NounoursOS"
chmod 755 /usr/bin/nounoursos-* /usr/libexec/nounoursos/*
systemctl enable nounoursos-maj-demarrage.service || true
python3 -m compileall -q /usr/lib/nounoursos/python || true

echo "[NounoursOS] Initramfs (pour prendre en compte Plymouth)"
update-initramfs -u -k all

echo "[NounoursOS] Bureau OK"
